{
  "name": "n8n-nodes-songgpt",
  "version": "0.1.0",
  "description": "Create and edit AI music with the SongGPT API in n8n workflows.",
  "license": "MIT",
  "homepage": "https://www.songgpt.ai/open-api",
  "keywords": [
    "n8n-community-node-package",
    "songgpt",
    "ai-music",
    "music-generation"
  ],
  "author": {
    "name": "nanograss",
    "email": "coldhumor0518@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nanograss/n8n-nodes-songgpt.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/SongGptApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/SongGpt/SongGpt.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.55.4",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
